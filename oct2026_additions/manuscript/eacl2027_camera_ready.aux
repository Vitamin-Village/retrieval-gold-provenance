\@writefile{lot}{\contentsline {table}{\numberline {40}{\ignorespaces Controlled swap on GraphRAG-Bench at the non-maximal census estimate $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}_{\mathcal  {K}}=0.75$ (Appendix~\ref {app:grbtrace}). Each row gives the paired hit@5 difference, aligned KG minus independent OpenIE KG, with its $10{,}000$-resample bootstrap $95\%$ CI and exact two-sided sign-test $p$, for the hybrid, PPR, and hybrid-PPR retrievers on two disjoint $200$-question splits. BM25 hit@5 is $0.520$ and $0.505$ on the two splits and is bit-identical across conditions. Under the independent KG the graph retrievers score $0.500$/$0.520$ (hybrid, within $0.02$ of BM25), $0.200$/$0.245$ (PPR), and $0.405$/$0.400$ (hybrid-PPR), the latter two well below BM25. The largest swap is in \textbf  {bold}.}}{43}{table.caption.88}\protected@file@percent }
\newlabel{tab:graphragbench}{{40}{43}{Controlled swap on GraphRAG-Bench at the non-maximal census estimate $\Chat _{\kg }=0.75$ (Appendix~\ref {app:grbtrace}). Each row gives the paired hit@5 difference, aligned KG minus independent OpenIE KG, with its $10{,}000$-resample bootstrap $95\%$ CI and exact two-sided sign-test $p$, for the hybrid, PPR, and hybrid-PPR retrievers on two disjoint $200$-question splits. BM25 hit@5 is $0.520$ and $0.505$ on the two splits and is bit-identical across conditions. Under the independent KG the graph retrievers score $0.500$/$0.520$ (hybrid, within $0.02$ of BM25), $0.200$/$0.245$ (PPR), and $0.405$/$0.400$ (hybrid-PPR), the latter two well below BM25. The largest swap is in \best {bold}}{table.caption.88}{}}
