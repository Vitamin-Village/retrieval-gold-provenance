\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Paired swap effect, aligned KG minus independent KG, on retrieval hit@5 (dark) and on the answer accuracy of two fixed readers (colored, with bootstrap $95\%$ CIs), per retriever and split. Answer accuracy is alias-aware EM, and LM-judge accuracy on GraphRAG-Bench. The answer-level effect is large on 2WikiMultiHop. On GraphRAG-Bench it is clearest for PPR ($+0.045$ to $+0.220$, significant in three of four reader--split cells), while the hybrid-PPR cells are $+0.040$ to $+0.090$ with one of four significant. On STaRK-Prime the retrieval swap is small and no answer-level cell is significant. On MetaQA the readers gain little from gold passages over BM25 passages (Table~\ref {tab:readerref}), so the answer-level swap stays near zero; one cell, Llama with PPR on the first split, reaches $+0.060$ ($p=0.036$).}}{32}{figure.caption.58}\protected@file@percent }
\newlabel{fig:e2e}{{5}{32}{Paired swap effect, aligned KG minus independent KG, on retrieval hit@5 (dark) and on the answer accuracy of two fixed readers (colored, with bootstrap $95\%$ CIs), per retriever and split. Answer accuracy is alias-aware EM, and LM-judge accuracy on GraphRAG-Bench. The answer-level effect is large on 2WikiMultiHop. On GraphRAG-Bench it is clearest for PPR ($+0.045$ to $+0.220$, significant in three of four reader--split cells), while the hybrid-PPR cells are $+0.040$ to $+0.090$ with one of four significant. On STaRK-Prime the retrieval swap is small and no answer-level cell is significant. On MetaQA the readers gain little from gold passages over BM25 passages (Table~\ref {tab:readerref}), so the answer-level swap stays near zero; one cell, Llama with PPR on the first split, reaches $+0.060$ ($p=0.036$)}{figure.caption.58}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Dose curves in retrieval and in answer accuracy on the first 2WikiMultiHop split. Left: edge fraction $f$ of the aligned KG (hybrid retriever). Right: fraction $q$ of transplanted inventory nodes whose gold node-to-passage mapping is restored, for the hybrid retriever (solid) and PPR (dashed). For the hybrid retriever, edges add little to either metric. Restoring the mapping raises both metrics for PPR, but for the hybrid retriever it raises only hit@5 and leaves EM flat.}}{32}{figure.caption.59}\protected@file@percent }
\newlabel{fig:e2edose}{{6}{32}{Dose curves in retrieval and in answer accuracy on the first 2WikiMultiHop split. Left: edge fraction $f$ of the aligned KG (hybrid retriever). Right: fraction $q$ of transplanted inventory nodes whose gold node-to-passage mapping is restored, for the hybrid retriever (solid) and PPR (dashed). For the hybrid retriever, edges add little to either metric. Restoring the mapping raises both metrics for PPR, but for the hybrid retriever it raises only hit@5 and leaves EM flat}{figure.caption.59}{}}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Edge-subsample dose--response of the 2WikiMultiHop KG swap. As the aligned KG's edges are subsampled at fraction $f$, with the retained count in the Edges column, the hybrid retriever's hit@5 and the paired advantage $\Delta $ over the fixed BM25 baseline change little. For this retriever the effect is thus carried by the aligned inventory and its retained node-to-passage mapping rather than by edge connectivity (Table~\ref {tab:zeroedge} gives all retrievers). The $\Delta $ column is the hybrid retriever's hit@5 advantage over BM25 under the aligned KG; the swap effect of \S  \ref {sec:results} subtracts the independent KG's advantage of $0.010$, giving $0.160$ at full edges. The highest hybrid hit@5 and $\Delta $ values are in \textbf  {bold}.}}{32}{table.caption.60}\protected@file@percent }
\newlabel{tab:dose}{{20}{32}{Edge-subsample dose--response of the 2WikiMultiHop KG swap. As the aligned KG's edges are subsampled at fraction $f$, with the retained count in the Edges column, the hybrid retriever's hit@5 and the paired advantage $\Delta $ over the fixed BM25 baseline change little. For this retriever the effect is thus carried by the aligned inventory and its retained node-to-passage mapping rather than by edge connectivity (Table~\ref {tab:zeroedge} gives all retrievers). The $\Delta $ column is the hybrid retriever's hit@5 advantage over BM25 under the aligned KG; the swap effect of \S \ref {sec:results} subtracts the independent KG's advantage of $0.010$, giving $0.160$ at full edges. The highest hybrid hit@5 and $\Delta $ values are in \best {bold}}{table.caption.60}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Answer-accuracy swap against the hit@5 swap (left) and against the hit@5 swap times the reader's headroom, gold-only minus BM25-passage accuracy floored at zero (right), for the $100$ benchmark--split--retriever--reader cells of the open-weight readers: main runs, BGE-M3 runs, HippoRAG~2, and Mistral-Small-24B on 2WikiMultiHop. Dashed lines are no-intercept least-squares fits. Headroom explains why MetaQA's retrieval swaps do not reach its answers.}}{33}{figure.caption.65}\protected@file@percent }
\newlabel{fig:cells}{{7}{33}{Answer-accuracy swap against the hit@5 swap (left) and against the hit@5 swap times the reader's headroom, gold-only minus BM25-passage accuracy floored at zero (right), for the $100$ benchmark--split--retriever--reader cells of the open-weight readers: main runs, BGE-M3 runs, HippoRAG~2, and Mistral-Small-24B on 2WikiMultiHop. Dashed lines are no-intercept least-squares fits. Headroom explains why MetaQA's retrieval swaps do not reach its answers}{figure.caption.65}{}}
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces Zero-edge control on 2WikiMultiHop: the aligned KG with every edge deleted and its nodes and gold passage links kept. The hybrid retriever keeps a significant advantage over the OpenIE KG (sign test $p=2.4\times 10^{-5}$ and $0.024$). PPR, which can reach the second gold passage only through an edge, collapses; the hybrid-PPR retriever returns to the OpenIE level ($p=1.0$ on both splits).}}{33}{table.caption.61}\protected@file@percent }
\newlabel{tab:zeroedge}{{21}{33}{Zero-edge control on 2WikiMultiHop: the aligned KG with every edge deleted and its nodes and gold passage links kept. The hybrid retriever keeps a significant advantage over the OpenIE KG (sign test $p=2.4\times 10^{-5}$ and $0.024$). PPR, which can reach the second gold passage only through an edge, collapses; the hybrid-PPR retriever returns to the OpenIE level ($p=1.0$ on both splits)}{table.caption.61}{}}
