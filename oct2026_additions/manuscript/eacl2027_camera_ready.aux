\@writefile{lot}{\contentsline {table}{\numberline {37}{\ignorespaces Controlled swap on MetaQA, with $\mathrm  {C}_{\mathcal  {K}}=1.0$. Each row gives the paired hit@5 difference, aligned KB minus independent OpenIE KG, with its $10{,}000$-resample bootstrap $95\%$ CI and exact two-sided sign-test $p$ over discordant pairs, for the hybrid retriever, a pure PPR retriever, and a hybrid-PPR variant on two disjoint $200$-question splits. The lexical baseline is bit-identical across conditions. The effect is positive in all six cells and significant in five; the hybrid retriever on the first split is marginal at $p=6.5\times 10^{-2}$. The largest swap is in \textbf  {bold}.}}{40}{table.caption.84}\protected@file@percent }
\newlabel{tab:metaqa}{{37}{40}{Controlled swap on MetaQA, with $\C _{\kg }=1.0$. Each row gives the paired hit@5 difference, aligned KB minus independent OpenIE KG, with its $10{,}000$-resample bootstrap $95\%$ CI and exact two-sided sign-test $p$ over discordant pairs, for the hybrid retriever, a pure PPR retriever, and a hybrid-PPR variant on two disjoint $200$-question splits. The lexical baseline is bit-identical across conditions. The effect is positive in all six cells and significant in five; the hybrid retriever on the first split is marginal at $p=6.5\times 10^{-2}$. The largest swap is in \best {bold}}{table.caption.84}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {C.10}Replication on a Text-Corpus Benchmark: GraphRAG-Bench}{41}{subsection.C.10}\protected@file@percent }
\newlabel{app:graphragbench}{{C.10}{41}{Replication on a Text-Corpus Benchmark: GraphRAG-Bench}{subsection.C.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {38}{\ignorespaces Controlled swap on STaRK-Prime at the non-maximal census estimate $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}_{\mathcal  {K}}=0.75$. Each row gives the paired hit@5 difference, aligned KB minus independent OpenIE KG, with its $10{,}000$-resample bootstrap $95\%$ CI and exact two-sided sign-test $p$, for the hybrid, PPR, and hybrid-PPR retrievers on two disjoint $200$-question splits. The swap attenuates relative to the maximal-circularity benchmarks and is significant in only one of six cells. We therefore report STaRK-Prime as a non-maximal point rather than a confirmed causal point: every retriever, BM25 included, reaches at most $0.275$ hit@5 in these runs, and several graph retrievers score below BM25.}}{41}{table.caption.85}\protected@file@percent }
\newlabel{tab:stark}{{38}{41}{Controlled swap on STaRK-Prime at the non-maximal census estimate $\Chat _{\kg }=0.75$. Each row gives the paired hit@5 difference, aligned KB minus independent OpenIE KG, with its $10{,}000$-resample bootstrap $95\%$ CI and exact two-sided sign-test $p$, for the hybrid, PPR, and hybrid-PPR retrievers on two disjoint $200$-question splits. The swap attenuates relative to the maximal-circularity benchmarks and is significant in only one of six cells. We therefore report STaRK-Prime as a non-maximal point rather than a confirmed causal point: every retriever, BM25 included, reaches at most $0.275$ hit@5 in these runs, and several graph retrievers score below BM25}{table.caption.85}{}}
\@writefile{lot}{\contentsline {table}{\numberline {39}{\ignorespaces BM25-miss stratum analysis of the STaRK-Prime swap, by the condition-independent BM25 stratum. In the BM25-miss stratum, of sizes $173$ and $157$, the graph channel has room to help; the swap is positive in all six cells and significant in three, marked \textbf  {bold}. In the complementary BM25-hit stratum, of sizes $27$ and $43$, BM25 already retrieves the gold; the hybrid and PPR effects are negative, and the hybrid-PPR effects are positive. No cell there is significant by the sign test, although the bootstrap CI of the hybrid retriever on the first split, $[-0.333,-0.037]$, excludes zero. The all-positive pattern is specific to the BM25-miss stratum, but this contrast does not exclude other differences between the strata. The hybrid-PPR cells in the small BM25-hit stratum are noisy. We report this analysis as exploratory; by the sign test the hybrid retriever is nonsignificant on both strata.}}{42}{table.caption.86}\protected@file@percent }
\newlabel{tab:starkheadroom}{{39}{42}{BM25-miss stratum analysis of the STaRK-Prime swap, by the condition-independent BM25 stratum. In the BM25-miss stratum, of sizes $173$ and $157$, the graph channel has room to help; the swap is positive in all six cells and significant in three, marked \best {bold}. In the complementary BM25-hit stratum, of sizes $27$ and $43$, BM25 already retrieves the gold; the hybrid and PPR effects are negative, and the hybrid-PPR effects are positive. No cell there is significant by the sign test, although the bootstrap CI of the hybrid retriever on the first split, $[-0.333,-0.037]$, excludes zero. The all-positive pattern is specific to the BM25-miss stratum, but this contrast does not exclude other differences between the strata. The hybrid-PPR cells in the small BM25-hit stratum are noisy. We report this analysis as exploratory; by the sign test the hybrid retriever is nonsignificant on both strata}{table.caption.86}{}}
