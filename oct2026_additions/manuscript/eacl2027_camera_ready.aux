\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Sample-size sensitivity of the 2WikiMultiHop swap effect. For the first $N$ questions in the split's sampled order, the table reports the mean paired hit@5 difference, aligned KG minus independent KG, for the hybrid retriever, with a $10{,}000$-resample bootstrap $95\%$ CI (fixed random seed). The estimate is stable near $0.16$ and the CI excludes zero at every $N$. The full-sample row, $N{=}200$, reproduces the $0.160$ estimate and CI $[0.100,0.220]$ of \S  \ref {sec:results}. The highest mean-difference values are in \textbf  {bold}.}}{33}{table.caption.62}\protected@file@percent }
\newlabel{tab:samplesize}{{22}{33}{Sample-size sensitivity of the 2WikiMultiHop swap effect. For the first $N$ questions in the split's sampled order, the table reports the mean paired hit@5 difference, aligned KG minus independent KG, for the hybrid retriever, with a $10{,}000$-resample bootstrap $95\%$ CI (fixed random seed). The estimate is stable near $0.16$ and the CI excludes zero at every $N$. The full-sample row, $N{=}200$, reproduces the $0.160$ estimate and CI $[0.100,0.220]$ of \S \ref {sec:results}. The highest mean-difference values are in \best {bold}}{table.caption.62}{}}
