\@writefile{lot}{\contentsline {table}{\numberline {30}{\ignorespaces Gold-concentration controls on the first and held-out 2WikiMultiHop splits. ``Dilute $g$'' attaches links from the aligned KG to random non-gold passages until the gold fraction of its linked passages is $g$; ``OpenIE gold-only'' restricts the independent KG's links to gold passages. Reference hit@5 (hybrid/PPR/hybrid-PPR) on the first split: aligned $0.535$/$0.740$/$0.750$, OpenIE $0.375$/$0.425$/$0.395$, BM25 $0.365$; on the held-out split: aligned $0.480$/$0.740$/$0.705$, OpenIE $0.365$/$0.430$/$0.370$, BM25 $0.355$. Exact sign-test $p$. Dilution removes the effect for PPR and not for the seed-based retrievers; concentration creates it from an independent structure.}}{37}{table.caption.76}\protected@file@percent }
\newlabel{tab:concentration}{{30}{37}{Gold-concentration controls on the first and held-out 2WikiMultiHop splits. ``Dilute $g$'' attaches links from the aligned KG to random non-gold passages until the gold fraction of its linked passages is $g$; ``OpenIE gold-only'' restricts the independent KG's links to gold passages. Reference hit@5 (hybrid/PPR/hybrid-PPR) on the first split: aligned $0.535$/$0.740$/$0.750$, OpenIE $0.375$/$0.425$/$0.395$, BM25 $0.365$; on the held-out split: aligned $0.480$/$0.740$/$0.705$, OpenIE $0.365$/$0.430$/$0.370$, BM25 $0.355$. Exact sign-test $p$. Dilution removes the effect for PPR and not for the seed-based retrievers; concentration creates it from an independent structure}{table.caption.76}{}}
\@writefile{lot}{\contentsline {table}{\numberline {31}{\ignorespaces MetaQA under the full KB restricted to the corpus (not induced from the evaluated questions; index over all $1{,}250$ passages, gold fraction $0.31$), compared with the aligned arm (Aligned), the independent OpenIE KG, and BM25. Exact sign-test $p$: hybrid $8.6\times 10^{-4}$ and $2.6\times 10^{-3}$, PPR $1.8\times 10^{-3}$ and $1.2\times 10^{-4}$, hybrid-PPR $0.45$ and $0.63$.}}{37}{table.caption.77}\protected@file@percent }
\newlabel{tab:fullkb}{{31}{37}{MetaQA under the full KB restricted to the corpus (not induced from the evaluated questions; index over all $1{,}250$ passages, gold fraction $0.31$), compared with the aligned arm (Aligned), the independent OpenIE KG, and BM25. Exact sign-test $p$: hybrid $8.6\times 10^{-4}$ and $2.6\times 10^{-3}$, PPR $1.8\times 10^{-3}$ and $1.2\times 10^{-4}$, hybrid-PPR $0.45$ and $0.63$}{table.caption.77}{}}
\@writefile{lot}{\contentsline {table}{\numberline {32}{\ignorespaces Coverage stratification of the graph-over-BM25 hit@5 advantage under the independent OpenIE KG. Questions are stratified by whether the OpenIE node inventory covers all, some, or none of their gold-title set, with stratum sizes $68/88/44$ on the first split and $79/87/34$ on the held-out split. Within a stratum, $\Delta $ is the paired per-question advantage, and the last column is the $10{,}000$-resample bootstrap $95\%$ CI of the fully-covered-versus-rest difference. Each row's stratum values average, weighted by stratum size, to that retriever's own overall OpenIE-condition advantage, $+0.010$ for the hybrid retriever and up to $+0.075$ for PPR. The largest stratum advantage is in \textbf  {bold}.}}{37}{table.caption.78}\protected@file@percent }
\newlabel{tab:stratification}{{32}{37}{Coverage stratification of the graph-over-BM25 hit@5 advantage under the independent OpenIE KG. Questions are stratified by whether the OpenIE node inventory covers all, some, or none of their gold-title set, with stratum sizes $68/88/44$ on the first split and $79/87/34$ on the held-out split. Within a stratum, $\Delta $ is the paired per-question advantage, and the last column is the $10{,}000$-resample bootstrap $95\%$ CI of the fully-covered-versus-rest difference. Each row's stratum values average, weighted by stratum size, to that retriever's own overall OpenIE-condition advantage, $+0.010$ for the hybrid retriever and up to $+0.075$ for PPR. The largest stratum advantage is in \best {bold}}{table.caption.78}{}}
