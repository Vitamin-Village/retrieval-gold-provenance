\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Verbatim construction quotes for every axis-level census judgment, part~1 of~2: the five benchmarks with $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}_{\mathcal  {K}}=0$ and our lower calibration anchor, in the order of Table~\ref {tab:census}. Each row is one gold-unit axis of one benchmark and gives the axis-level census value $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}_a$ with its bin under the rubric of Appendix~\ref {app:rubricfull}, a construction quote supporting that bin, and the quote's source. Quotes are verbatim from the benchmark's own paper or dataset documentation; \ldots  \ marks omitted text, footnote markers are dropped, and sub- and superscripts are typeset as in the source. Section and appendix numbers refer to the cited paper, in its arXiv version where the bibliography lists one. The lower anchor is our own reference benchmark; its quotes are verbatim from its generator prompt (Appendix~\ref {app:prompts}), and its construction is described in Appendix~\ref {app:protocol}. Part~2 is Table~\ref {tab:quotesfull2}.}}{17}{table.caption.37}\protected@file@percent }
\newlabel{tab:quotesfull1}{{6}{17}{Verbatim construction quotes for every axis-level census judgment, part~1 of~2: the five benchmarks with $\Chat _{\kg }=0$ and our lower calibration anchor, in the order of Table~\ref {tab:census}. Each row is one gold-unit axis of one benchmark and gives the axis-level census value $\Chat _a$ with its bin under the rubric of Appendix~\ref {app:rubricfull}, a construction quote supporting that bin, and the quote's source. Quotes are verbatim from the benchmark's own paper or dataset documentation; \ldots \ marks omitted text, footnote markers are dropped, and sub- and superscripts are typeset as in the source. Section and appendix numbers refer to the cited paper, in its arXiv version where the bibliography lists one. The lower anchor is our own reference benchmark; its quotes are verbatim from its generator prompt (Appendix~\ref {app:prompts}), and its construction is described in Appendix~\ref {app:protocol}. Part~2 is Table~\ref {tab:quotesfull2}}{table.caption.37}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Verbatim construction quotes for every axis-level census judgment, part~2 of~2: the six KG-constructed benchmarks and our upper calibration anchor ($\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}_{\mathcal  {K}}\geq 0.75$). Each row is one gold-unit axis with its census value $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}_a$, its bin under the rubric of Appendix~\ref {app:rubricfull}, a verbatim quote supporting the bin (\ldots  \ marks omissions), and the quote's source. STaRK quotes are from the paper's first arXiv version, which later versions reword. Upper-anchor quotes are from Appendix~\ref {app:protocol}. Part~1 is Table~\ref {tab:quotesfull1}.}}{18}{table.caption.38}\protected@file@percent }
\newlabel{tab:quotesfull2}{{7}{18}{Verbatim construction quotes for every axis-level census judgment, part~2 of~2: the six KG-constructed benchmarks and our upper calibration anchor ($\Chat _{\kg }\geq 0.75$). Each row is one gold-unit axis with its census value $\Chat _a$, its bin under the rubric of Appendix~\ref {app:rubricfull}, a verbatim quote supporting the bin (\ldots \ marks omissions), and the quote's source. STaRK quotes are from the paper's first arXiv version, which later versions reword. Upper-anchor quotes are from Appendix~\ref {app:protocol}. Part~1 is Table~\ref {tab:quotesfull1}}{table.caption.38}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Full per-axis census, one row per gold-unit axis, expanding Table~\ref {tab:census}. The per-axis values $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}_a$ are reproduced from Table~\ref {tab:census}. The mechanism column marks derivation from the KG $\mathcal  {K}$ (``KG, answer string'': an answer string generated from $\mathcal  {K}$, which enters $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}$ but not $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {C}$}\mathaccent "0362{\mathrm  {C}}_{\mathcal  {K}}$), derivation from the answer surface $A$, selection guided by either, or independence from both. The $29$ rows match the $29$ axis-level judgments of Table~\ref {tab:irr}; the verbatim quote behind each is in Tables~\ref {tab:quotesfull1} and~\ref {tab:quotesfull2}.}}{19}{table.caption.39}\protected@file@percent }
